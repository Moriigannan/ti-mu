def draw_table(fig_width, headers, rows, filename, title=None):
    """绘制表格图片"""
    fig, ax = plt.subplots(figsize=(fig_width, max(0.6 * len(rows), 2)))
    ax.axis('off')
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)

    n_cols = len(headers)
    n_rows = len(rows)

    # 表格布局参数
    margin_left = 0.05
    margin_right = 0.95
    margin_top = 0.95
    margin_bottom = 0.05
    col_w = (margin_right - margin_left) / n_cols
    row_h = (margin_top - margin_bottom) / (n_rows + 1)  # +1 for header

    # 颜色定义
    header_color = '#2E5C8A'
    text_color_white = 'white'
    text_color_dark = '#333333'
    alt_row_color = '#F2F7FC'
    border_color = '#B0C4DE'

    # 画表头
    for j, h in enumerate(headers):
        x = margin_left + j * col_w
        y = margin_top - row_h
        rect = plt.Rectangle((x, y), col_w, row_h, facecolor=header_color, edgecolor=border_color, linewidth=1)
        ax.add_patch(rect)
        ax.text(x + col_w / 2, y + row_h / 2, h, ha='center', va='center',
                fontsize=10, fontweight='bold', color=text_color_white)

    # 画数据行
    for i, row in enumerate(rows):
        y = margin_top - (i + 2) * row_h
        bg_color = alt_row_color if i % 2 == 0 else 'white'
        for j, val in enumerate(row):
            x = margin_left + j * col_w
            rect = plt.Rectangle((x, y), col_w, row_h, facecolor=bg_color, edgecolor=border_color, linewidth=1)
            ax.add_patch(rect)
            # 数字列右对齐，文字列居中
            try:
                float(val)
                ha = 'right'
                x_text = x + col_w * 0.9
            except (ValueError, TypeError):
                ha = 'center'
                x_text = x + col_w / 2
            ax.text(x_text, y + row_h / 2, str(val), ha=ha, va='center',
                    fontsize=9.5, color=text_color_dark)

    # 标题
    if title:
        ax.text(0.5, margin_top + 0.02, title, ha='center', va='bottom',
                fontsize=12, fontweight='bold', color='#2E5C8A', transform=ax.transAxes)

    fig.savefig(filename, dpi=150, bbox_inches='tight', facecolor='white')
    plt.close()
    print(f"  表格已保存: {os.path.basename(filename)}")

