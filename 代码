def read_load_data(filepath):
    """读取附件1：各园区典型日负荷数据"""
    df = pd.read_excel(filepath)
    # 第一行是表头，数据从第二行开始
    # iloc[:, 1] -> 第2列(园区A负荷), iloc[:, 2] -> 第3列(园区B负荷), iloc[:, 3] -> 第4列(园区C负荷)
    load_A = df.iloc[:, 1].values.astype(float)
    load_B = df.iloc[:, 2].values.astype(float)
    load_C = df.iloc[:, 3].values.astype(float)
    return load_A, load_B, load_C

def read_wind_solar_data(filepath):
    """读取附件2：各园区典型日风光发电数据（标幺值）
    
    文件结构：
    Row 0: 说明行（文本）
    Row 1: 表头行1（时间 | 园区A光伏 | 园区B风电 | 园区C | NaN）
    Row 2: 表头行2（NaN | NaN | NaN | 光伏出力 | 风电出力）
    Row 3-26: 数据行（24小时）
    
    列映射：col1=园区A光伏(p.u.), col2=园区B风电(p.u.), col3=园区C光伏(p.u.), col4=园区C风电(p.u.)
    """
    df = pd.read_excel(filepath, header=None)
    data_rows = []
    # 从第3行开始读取数据（跳过说明行和两行表头）
    for i in range(3, len(df)):
        val = df.iloc[i, 0]
        if pd.notna(val) and str(val).strip():
            # 提取列1-4的值并转换为float
            row_vals = df.iloc[i, 1:5]
            try:
                row_float = row_vals.astype(float)
                data_rows.append(row_float.values)
            except (ValueError, TypeError):
                continue
    data = np.array(data_rows)
    return data

def pu_to_actual(solar_pu, wind_pu, park_id):
    """将标幺值转换为实际功率(kW)"""
    park = PARKS[park_id]
    solar_actual = solar_pu * park["solar_cap"] if park["solar_cap"] > 0 else np.zeros_like(solar_pu)
    wind_actual = wind_pu * park["wind_cap"] if park["wind_cap"] > 0 else np.zeros_like(solar_pu)
    return solar_actual, wind_actual

# ============================================================
# 无储能基线计算
# ============================================================
def calc_baseline(load, solar, wind):
    """计算无储能基线指标"""
    solar_used = np.minimum(solar, load)
    remaining = load - solar_used
    wind_used = np.minimum(wind, remaining)
    grid_buy = np.maximum(0, remaining - wind_used)
    curtail_solar = np.maximum(0, solar - solar_used)
    curtail_wind = np.maximum(0, wind - wind_used)
    curtail = curtail_solar + curtail_wind

    total_buy = np.sum(grid_buy)
    total_curtail = np.sum(curtail)
    total_solar_used = np.sum(solar_used)
    total_wind_used = np.sum(wind_used)
    total_cost = total_buy * GRID_PRICE + total_solar_used * SOLAR_PRICE + total_wind_used * WIND_PRICE
    total_supply = np.sum(load)
    unit_cost = total_cost / total_supply if total_supply > 0 else 0

    return {
        "buy_energy": total_buy, "curtail_energy": total_curtail,
        "solar_used": total_solar_used, "wind_used": total_wind_used,
        "total_cost": total_cost, "unit_cost": unit_cost, "total_supply": total_supply,
        "grid_buy": grid_buy, "curtail": curtail,
        "solar_used_h": solar_used, "wind_used_h": wind_used,
    }

# ============================================================
# 储能运行模拟
# ============================================================
def simulate_storage(load, solar, wind, P_stor, C_stor):
    """储能运行模拟：富余绿电充电，供电不足时放电"""
    total_gen = solar + wind
    soc = C_stor * 0.5  # 初始电量(kWh)

    charge_p = np.zeros(24)
    discharge_p = np.zeros(24)
    grid_buy = np.zeros(24)
    curtail = np.zeros(24)
    soc_trace = [soc]

    for t in range(24):
        surplus = total_gen[t] - load[t]

        if surplus > 0:
            # 有富余绿电：优先给储能充电
            max_charge_p = P_stor
            max_charge_e = (SOC_MAX * C_stor - soc) / CHARGE_EFF
            actual_charge_e = min(surplus, max_charge_p, max_charge_e)
            actual_charge_e = max(actual_charge_e, 0)
            charge_p[t] = actual_charge_e
            soc += actual_charge_e * CHARGE_EFF
            remaining = surplus - actual_charge_e
            curtail[t] = max(remaining, 0)
            grid_buy[t] = 0
        else:
            # 供电不足：储能放电 + 电网补充
            deficit = -surplus
            max_discharge_p = P_stor
            max_discharge_e = (soc - SOC_MIN * C_stor) * DISCHARGE_EFF
            actual_discharge_e = min(deficit, max_discharge_p, max_discharge_e)
            actual_discharge_e = max(actual_discharge_e, 0)
            discharge_p[t] = actual_discharge_e
            soc -= actual_discharge_e / DISCHARGE_EFF
            grid_buy[t] = max(0, deficit - actual_discharge_e)

        soc = np.clip(soc, SOC_MIN * C_stor, SOC_MAX * C_stor)
        soc_trace.append(soc)

    # 计算弃电（能量守恒）
    curtail_final = np.zeros(24)
    for t in range(24):
        curtail_final[t] = total_gen[t] + discharge_p[t] + grid_buy[t] - load[t] - charge_p[t]
        curtail_final[t] = max(curtail_final[t], 0)

    # 消纳计算
    solar_used_h = np.minimum(solar, load)
    remaining_after_solar = load - solar_used_h
    wind_used_h = np.minimum(wind, remaining_after_solar)

    total_buy = np.sum(grid_buy)
    total_curtail = np.sum(curtail_final)
    total_solar_used = np.sum(solar_used_h)
    total_wind_used = np.sum(wind_used_h)
    total_cost = total_buy * GRID_PRICE + total_solar_used * SOLAR_PRICE + total_wind_used * WIND_PRICE
    total_supply = np.sum(load)
    unit_cost = total_cost / total_supply if total_supply > 0 else 0

    return {
        "buy_energy": total_buy, "curtail_energy": total_curtail,
        "solar_used": total_solar_used, "wind_used": total_wind_used,
        "total_cost": total_cost, "unit_cost": unit_cost, "total_supply": total_supply,
        "grid_buy": grid_buy, "curtail": curtail_final,
        "solar_used_h": solar_used_h, "wind_used_h": wind_used_h,
        "discharge_p": discharge_p, "charge_p": charge_p,
        "soc_trace": soc_trace,
    }

# ============================================================
# 储能容量优化（网格搜索）
# ============================================================
def optimize_storage_capacity(load, solar, wind):
    """以全寿命周期成本最低为目标优化储能功率与容量"""
    best_cost = float("inf")
    best_config = None
    scan_results = []

    P_range = [10, 20, 30, 40, 50, 60, 80, 100]
    C_range = [20, 40, 60, 80, 100, 120, 150, 200, 250, 300]

    for P in P_range:
        for C in C_range:
            if C < P * 2:
                continue
            res = simulate_storage(load, solar, wind, P, C)
            storage_cap_cost = C * STORAGE_CAP_PRICE
            storage_pow_cost = P * STORAGE_POWER_PRICE
            annual_investment = (storage_cap_cost + storage_pow_cost) / STORAGE_LIFESPAN
            annual_total = res["total_cost"] * 365 + annual_investment

            scan_results.append({
                "P": P, "C": C,
                "annual_total": annual_total,
                "daily_cost": res["total_cost"],
                "annual_investment": annual_investment,
            })

            if annual_total < best_cost:
                best_cost = annual_total
                best_config = {"P": P, "C": C}

    return best_config, scan_results

# ============================================================
# 联合运营分析
# ============================================================
def joint_operation_analysis(load_A, load_B, load_C, solar_A, solar_B, solar_C, wind_A, wind_B, wind_C):
    """三个园区联合运营 vs 独立运营经济性对比"""
    # 独立运营无储能基线
    bl_A = calc_baseline(load_A, solar_A, wind_A)
    bl_B = calc_baseline(load_B, solar_B, wind_B)
    bl_C = calc_baseline(load_C, solar_C, wind_C)
    indep_bl_cost = bl_A["total_cost"] + bl_B["total_cost"] + bl_C["total_cost"]

    # 独立运营+储能
    stor_A = simulate_storage(load_A, solar_A, wind_A, 50, 100)
    stor_B = simulate_storage(load_B, solar_B, wind_B, 50, 100)
    stor_C = simulate_storage(load_C, solar_C, wind_C, 50, 100)
    indep_stor_cost = stor_A["total_cost"] + stor_B["total_cost"] + stor_C["total_cost"]

    # 联合运营（负荷和发电汇总）
    joint_load = load_A + load_B + load_C
    joint_solar = solar_A + solar_B + solar_C
    joint_wind = wind_A + wind_B + wind_C

    joint_bl = calc_baseline(joint_load, joint_solar, joint_wind)
    # 联合运营+储能（总功率和容量为三园区之和）
    joint_stor = simulate_storage(joint_load, joint_solar, joint_wind, 150, 300)

    saving = indep_stor_cost - joint_stor["total_cost"]
    saving_rate = saving / indep_stor_cost * 100 if indep_stor_cost > 0 else 0

    return {
        "baseline": {"A": bl_A, "B": bl_B, "C": bl_C},
        "storage": {"A": stor_A, "B": stor_B, "C": stor_C},
        "joint_bl": joint_bl,
        "joint_stor": joint_stor,
        "indep_bl_cost": indep_bl_cost,
        "indep_stor_cost": indep_stor_cost,
        "joint_stor_cost": joint_stor["total_cost"],
        "saving": saving,
        "saving_rate": saving_rate,
    }

