def find_data_file(keywords):
    """在多个目录中模糊查找文件（支持D盘、当前目录、data子目录等）"""
    # 搜索目录优先级列表（按优先级从高到低）
    search_dirs = []
    
    # 1. 优先搜索data子目录
    if os.path.exists(DATA_DIR):
        search_dirs.append(DATA_DIR)
    
    # 2. 搜索脚本同级目录
    search_dirs.append(ROOT_DIR)
    
    # 3. 搜索D盘根目录（用户文件放在D盘的情况）
    if os.path.exists("D:\\"):
        search_dirs.append("D:\\")
    
    # 4. 搜索D:\data\目录
    if os.path.exists("D:\\data"):
        search_dirs.append("D:\\data")
    
    # 5. 搜索D:\项目文件夹\（常见命名）
    for folder_name in ["项目", "作业", "课程", "data", "数据"]:
        folder_path = f"D:\\{folder_name}"
        if os.path.exists(folder_path):
            search_dirs.append(folder_path)
    
    # 去重（保持顺序）
    seen = set()
    unique_dirs = []
    for d in search_dirs:
        if d not in seen:
            seen.add(d)
            unique_dirs.append(d)
    search_dirs = unique_dirs
    
    print(f"[路径调试] 将在以下目录搜索文件: {search_dirs}")
    
    for directory in search_dirs:
        if not os.path.exists(directory):
            continue
        # 打印目录内容用于调试（仅第一次）
        try:
            files_in_dir = os.listdir(directory)
            print(f"  [调试] {directory} 中的文件: {files_in_dir[:20]}")
        except:
            pass
        
        for file in os.listdir(directory):
            # 去除末尾的_1等编号后缀进行匹配
            base_name = file.replace("_1.xlsx", ".xlsx").replace("_1.xls", ".xls")
            if keywords in base_name or keywords in file:
                found_path = os.path.join(directory, file)
                print(f"  [成功] 找到文件: {found_path}")
                return found_path
    return None

